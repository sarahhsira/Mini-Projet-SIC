<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Demande de carte EDAHABIA (As-Is)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Client">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Agent de guichet">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Responsable">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Besoin d'une carte"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Se déplacer au bureau de poste avec les documents"><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t2" name="Faire la queue et déposer le dossier"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Vérifier les documents (identité, justificatif, photo)"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g1" name="Documents complets ?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t5" name="Saisir la demande dans le système"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t4b" name="Demander les documents manquants"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t4c" name="Retourner chercher les documents"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t6" name="Valider la demande"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g2" name="Demande acceptée ?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t8" name="Lancer la fabrication de la carte"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t7b" name="Informer le client du refus"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_refus" name="Prendre connaissance du refus"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="end_rej" name="Demande rejetée"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="timer" name="Attendre environ 15 jours"><bpmn:incoming>f15</bpmn:incoming><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:timerEventDefinition id="timer_td"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="t10" name="Se déplacer pour vérifier si la carte est prête"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t11" name="Vérifier si la carte est arrivée"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g3" name="Carte prête ?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t13" name="Remettre la carte contre pièce d'identité"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_recv" name="Recevoir la carte"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="end_ok" name="Carte remise"><bpmn:incoming>f22</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="f5" name="Oui" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="f6" name="Non" sourceRef="g1" targetRef="t4b" />
    <bpmn:sequenceFlow id="f7" sourceRef="t4b" targetRef="t4c" />
    <bpmn:sequenceFlow id="f8" sourceRef="t4c" targetRef="t1" />
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="g2" />
    <bpmn:sequenceFlow id="f11" name="Non" sourceRef="g2" targetRef="t7b" />
    <bpmn:sequenceFlow id="f12" sourceRef="t7b" targetRef="t_refus" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_refus" targetRef="end_rej" />
    <bpmn:sequenceFlow id="f14" name="Oui" sourceRef="g2" targetRef="t8" />
    <bpmn:sequenceFlow id="f15" sourceRef="t8" targetRef="timer" />
    <bpmn:sequenceFlow id="f16" sourceRef="timer" targetRef="t10" />
    <bpmn:sequenceFlow id="f17" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f18" sourceRef="t11" targetRef="g3" />
    <bpmn:sequenceFlow id="f19" name="Oui" sourceRef="g3" targetRef="t13" />
    <bpmn:sequenceFlow id="f20" name="Non" sourceRef="g3" targetRef="timer" />
    <bpmn:sequenceFlow id="f21" sourceRef="t13" targetRef="t_recv" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_recv" targetRef="end_ok" />
  </bpmn:process>
