    <bpmn:sequenceFlow id="f28" sourceRef="u_recep" targetRef="g_m2" />
    <bpmn:sequenceFlow id="f29" sourceRef="g_m2" targetRef="s_clot" />
    <bpmn:sequenceFlow id="f30" sourceRef="s_clot" targetRef="end_ok" />
  </bpmn:process>
