        <bpmn:flowNodeRef>u_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_recep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0_1" name="Plateforme ECCP (système)">
        <bpmn:flowNodeRef>s_otp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_elig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_elig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_nok1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_nok1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_enreg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_nok2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_nok2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_fab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_clot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0_2" name="Service de traitement">
        <bpmn:flowNodeRef>a_verif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_fab</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0_3" name="Bureau de poste / Livraison">
        <bpmn:flowNodeRef>a_ach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_liv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Souhait d'obtenir une carte EDAHABIA"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_insc" name="Déjà inscrit à ECCP ?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="u_ins" name="S'inscrire en ligne (n° CCP, téléphone, pièce d'identité)"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="u_login" name="Se connecter à ECCP"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s_otp" name="Vérifier l'identité (code OTP par SMS)"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_m1"><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_elig" name="Vérifier automatiquement l'éligibilité (CCP actif, mobile, pas de carte, personne physique)"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_elig" name="Éligible ?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_nok1" name="Informer le client du motif"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="end_nok1" name="Demande impossible"><bpmn:incoming>f10</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="u_choix" name="Choisir le type de carte et le mode de réception"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s_enreg" name="Enregistrer la commande (statut : reçue)"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="s_conf" name="Envoyer le SMS de confirmation de commande"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="a_verif" name="Vérifier les informations de la commande"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_ok" name="Informations valides ?"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_nok2" name="Informer le client du refus avec motif"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="end_nok2" name="Demande rejetée"><bpmn:incoming>f17</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="s_fab" name="Lancer la fabrication (statut : en fabrication)"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="a_fab" name="Personnaliser et fabriquer la carte"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a_ach" name="Acheminer la carte vers le bureau ou la livraison"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_mode" name="Mode de réception ?"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_sms" name="Envoyer le SMS « carte disponible »"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="u_ret" name="Se présenter au bureau avec la pièce d'identité"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a_rem" name="Vérifier l'identité et remettre la carte et le code PIN"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a_liv" name="Livrer la carte à domicile"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="u_recep" name="Recevoir la carte à domicile"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_m2"><bpmn:incoming>f27</bpmn:incoming><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_clot" name="Clôturer la demande (statut : remise)"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Carte remise au client"><bpmn:incoming>f30</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="g_insc" />
