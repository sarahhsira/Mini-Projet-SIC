  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Demande de carte EDAHABIA 100 % en ligne (To-Be)" processRef="Process_0" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0">
      <bpmn:lane id="Lane_0_0" name="Client">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_insc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_ins</bpmn:flowNodeRef>
