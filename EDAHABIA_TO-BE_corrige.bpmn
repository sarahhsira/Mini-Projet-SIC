<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Client (titulaire CCP)" processRef="Process_0" />
    <bpmn:participant id="Participant_1" name="Algérie Poste – Demande de carte EDAHABIA 100 % en ligne (To-Be)" processRef="Process_1" />
    <bpmn:messageFlow id="m1" name="Demande d'inscription" sourceRef="u_ins" targetRef="p_ms_ins" />
    <bpmn:messageFlow id="m2" name="Commande de carte" sourceRef="u_choix" targetRef="p_ms" />
    <bpmn:messageFlow id="m3" name="Motif de non-éligibilité" sourceRef="s_nok1" targetRef="c_nok1" />
    <bpmn:messageFlow id="m4" name="SMS de confirmation" sourceRef="s_conf" targetRef="c_conf" />
    <bpmn:messageFlow id="m5" name="Refus avec motif" sourceRef="s_nok2" targetRef="c_nok2" />
    <bpmn:messageFlow id="m6" name="SMS carte disponible" sourceRef="s_sms" targetRef="c_sms" />
    <bpmn:messageFlow id="m7" name="SMS d'expédition" sourceRef="s_exp" targetRef="c_exp" />
    <bpmn:messageFlow id="m8" name="Pièce d'identité" sourceRef="u_ret" targetRef="a_vid" />
    <bpmn:messageFlow id="m9" name="Carte + code PIN" sourceRef="a_rem" targetRef="u_rec" />
    <bpmn:messageFlow id="m10" name="Carte livrée" sourceRef="a_liv" targetRef="u_rec2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0">
      <bpmn:lane id="Lane_0_0" name="Client">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_insc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_choix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_evt1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_nok1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_nok1c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_evt2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_nok2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_nok2c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_rec2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m2c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_okc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Souhait d'obtenir une carte EDAHABIA"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_insc" name="Déjà inscrit à ECCP ?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="u_ins" name="S'inscrire en ligne (n° CCP, téléphone, pièce d'identité)"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="u_login" name="Se connecter à ECCP"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_m1"><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="u_choix" name="Choisir le type de carte et le mode de réception, puis commander"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
    <bpmn:eventBasedGateway id="g_evt1"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_nok1" name="Notification : demande impossible"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:messageEventDefinition id="c_nok1_md" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_nok1c" name="Demande impossible"><bpmn:incoming>f10</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c_conf" name="SMS de confirmation de commande reçu"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:messageEventDefinition id="c_conf_md" /></bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="g_evt2"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing><bpmn:outgoing>f15</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_nok2" name="Notification de refus reçue"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:messageEventDefinition id="c_nok2_md" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_nok2c" name="Demande refusée"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c_sms" name="SMS « carte disponible » reçu"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:messageEventDefinition id="c_sms_md" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_exp" name="SMS d'expédition à domicile reçu"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:messageEventDefinition id="c_exp_md" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="u_ret" name="Se présenter au bureau avec la pièce d'identité"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="u_rec2" name="Recevoir la carte à domicile"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="u_rec" name="Recevoir la carte et le code PIN"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_m2c"><bpmn:incoming>f19</bpmn:incoming><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_okc" name="Carte reçue"><bpmn:incoming>f21</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="g_insc" />
    <bpmn:sequenceFlow id="f2" name="Oui" sourceRef="g_insc" targetRef="u_login" />
    <bpmn:sequenceFlow id="f3" name="Non" sourceRef="g_insc" targetRef="u_ins" />
    <bpmn:sequenceFlow id="f4" sourceRef="u_ins" targetRef="g_m1" />
    <bpmn:sequenceFlow id="f5" sourceRef="u_login" targetRef="g_m1" />
    <bpmn:sequenceFlow id="f6" sourceRef="g_m1" targetRef="u_choix" />
    <bpmn:sequenceFlow id="f7" sourceRef="u_choix" targetRef="g_evt1" />
    <bpmn:sequenceFlow id="f8" sourceRef="g_evt1" targetRef="c_conf" />
    <bpmn:sequenceFlow id="f9" sourceRef="g_evt1" targetRef="c_nok1" />
    <bpmn:sequenceFlow id="f10" sourceRef="c_nok1" targetRef="end_nok1c" />
    <bpmn:sequenceFlow id="f11" sourceRef="c_conf" targetRef="g_evt2" />
    <bpmn:sequenceFlow id="f12" sourceRef="g_evt2" targetRef="c_nok2" />
    <bpmn:sequenceFlow id="f13" sourceRef="c_nok2" targetRef="end_nok2c" />
    <bpmn:sequenceFlow id="f14" sourceRef="g_evt2" targetRef="c_sms" />
    <bpmn:sequenceFlow id="f15" sourceRef="g_evt2" targetRef="c_exp" />
    <bpmn:sequenceFlow id="f16" sourceRef="c_sms" targetRef="u_ret" />
    <bpmn:sequenceFlow id="f17" sourceRef="c_exp" targetRef="u_rec2" />
    <bpmn:sequenceFlow id="f18" sourceRef="u_ret" targetRef="u_rec" />
    <bpmn:sequenceFlow id="f19" sourceRef="u_rec" targetRef="g_m2c" />
    <bpmn:sequenceFlow id="f20" sourceRef="u_rec2" targetRef="g_m2c" />
    <bpmn:sequenceFlow id="f21" sourceRef="g_m2c" targetRef="end_okc" />
  </bpmn:process>
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1_0" name="Plateforme ECCP (système)">
        <bpmn:flowNodeRef>p_ms_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_ms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_elig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_elig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_nok1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_nok1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_enreg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_fab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_clot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1_1" name="Service de traitement">
        <bpmn:flowNodeRef>a_verif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_fab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_nok2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1_2" name="Bureau de poste / Livraison">
        <bpmn:flowNodeRef>a_ach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_vid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_liv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p_ms_ins" name="Demande d'inscription reçue"><bpmn:outgoing>p1</bpmn:outgoing><bpmn:messageEventDefinition id="p_ms_ins_md" /></bpmn:startEvent>
    <bpmn:serviceTask id="s_ins" name="Créer le compte et vérifier l'identité (code OTP par SMS)"><bpmn:incoming>p1</bpmn:incoming><bpmn:outgoing>p2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_ins" name="Compte créé"><bpmn:incoming>p2</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="p_ms" name="Commande de carte reçue"><bpmn:outgoing>p3</bpmn:outgoing><bpmn:messageEventDefinition id="p_ms_md" /></bpmn:startEvent>
    <bpmn:serviceTask id="s_elig" name="Vérifier automatiquement l'éligibilité (CCP actif, mobile, pas de carte, personne physique)"><bpmn:incoming>p3</bpmn:incoming><bpmn:outgoing>p4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_elig" name="Éligible ?"><bpmn:incoming>p4</bpmn:incoming><bpmn:outgoing>p5</bpmn:outgoing><bpmn:outgoing>p7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_nok1" name="Notifier le client du motif"><bpmn:incoming>p5</bpmn:incoming><bpmn:outgoing>p6</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="end_nok1" name="Demande impossible"><bpmn:incoming>p6</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="s_enreg" name="Enregistrer la commande (statut : reçue)"><bpmn:incoming>p7</bpmn:incoming><bpmn:outgoing>p8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="s_conf" name="Envoyer le SMS de confirmation de commande"><bpmn:incoming>p8</bpmn:incoming><bpmn:outgoing>p9</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="a_verif" name="Vérifier les informations de la commande"><bpmn:incoming>p9</bpmn:incoming><bpmn:outgoing>p10</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_ok" name="Informations valides ?"><bpmn:incoming>p10</bpmn:incoming><bpmn:outgoing>p11</bpmn:outgoing><bpmn:outgoing>p12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_fab" name="Lancer la fabrication (statut : en fabrication)"><bpmn:incoming>p11</bpmn:incoming><bpmn:outgoing>p14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="a_fab" name="Personnaliser et fabriquer la carte"><bpmn:incoming>p14</bpmn:incoming><bpmn:outgoing>p15</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="s_nok2" name="Notifier le refus avec motif"><bpmn:incoming>p12</bpmn:incoming><bpmn:outgoing>p13</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="end_rej" name="Demande rejetée"><bpmn:incoming>p13</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="a_ach" name="Acheminer la carte vers le bureau ou la livraison"><bpmn:incoming>p15</bpmn:incoming><bpmn:outgoing>p16</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_mode" name="Mode de réception ?"><bpmn:incoming>p16</bpmn:incoming><bpmn:outgoing>p17</bpmn:outgoing><bpmn:outgoing>p18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_sms" name="Envoyer le SMS « carte disponible »"><bpmn:incoming>p17</bpmn:incoming><bpmn:outgoing>p19</bpmn:outgoing></bpmn:sendTask>
    <bpmn:sendTask id="s_exp" name="Envoyer le SMS d'expédition à domicile"><bpmn:incoming>p18</bpmn:incoming><bpmn:outgoing>p20</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="a_vid" name="Vérifier l'identité du titulaire CCP"><bpmn:incoming>p19</bpmn:incoming><bpmn:outgoing>p21</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a_liv" name="Livrer la carte à domicile"><bpmn:incoming>p20</bpmn:incoming><bpmn:outgoing>p23</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a_rem" name="Remettre la carte et le code PIN"><bpmn:incoming>p21</bpmn:incoming><bpmn:outgoing>p22</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_m2"><bpmn:incoming>p22</bpmn:incoming><bpmn:incoming>p23</bpmn:incoming><bpmn:outgoing>p24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_clot" name="Clôturer la demande (statut : remise)"><bpmn:incoming>p24</bpmn:incoming><bpmn:outgoing>p25</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Demande clôturée"><bpmn:incoming>p25</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="p1" sourceRef="p_ms_ins" targetRef="s_ins" />
    <bpmn:sequenceFlow id="p2" sourceRef="s_ins" targetRef="end_ins" />
    <bpmn:sequenceFlow id="p3" sourceRef="p_ms" targetRef="s_elig" />
    <bpmn:sequenceFlow id="p4" sourceRef="s_elig" targetRef="g_elig" />
    <bpmn:sequenceFlow id="p5" name="Non" sourceRef="g_elig" targetRef="s_nok1" />
    <bpmn:sequenceFlow id="p6" sourceRef="s_nok1" targetRef="end_nok1" />
    <bpmn:sequenceFlow id="p7" name="Oui" sourceRef="g_elig" targetRef="s_enreg" />
    <bpmn:sequenceFlow id="p8" sourceRef="s_enreg" targetRef="s_conf" />
    <bpmn:sequenceFlow id="p9" sourceRef="s_conf" targetRef="a_verif" />
    <bpmn:sequenceFlow id="p10" sourceRef="a_verif" targetRef="g_ok" />
    <bpmn:sequenceFlow id="p11" name="Oui" sourceRef="g_ok" targetRef="s_fab" />
    <bpmn:sequenceFlow id="p12" name="Non" sourceRef="g_ok" targetRef="s_nok2" />
    <bpmn:sequenceFlow id="p13" sourceRef="s_nok2" targetRef="end_rej" />
    <bpmn:sequenceFlow id="p14" sourceRef="s_fab" targetRef="a_fab" />
    <bpmn:sequenceFlow id="p15" sourceRef="a_fab" targetRef="a_ach" />
    <bpmn:sequenceFlow id="p16" sourceRef="a_ach" targetRef="g_mode" />
    <bpmn:sequenceFlow id="p17" name="Retrait au bureau" sourceRef="g_mode" targetRef="s_sms" />
    <bpmn:sequenceFlow id="p18" name="Livraison" sourceRef="g_mode" targetRef="s_exp" />
    <bpmn:sequenceFlow id="p19" sourceRef="s_sms" targetRef="a_vid" />
    <bpmn:sequenceFlow id="p20" sourceRef="s_exp" targetRef="a_liv" />
    <bpmn:sequenceFlow id="p21" sourceRef="a_vid" targetRef="a_rem" />
    <bpmn:sequenceFlow id="p22" sourceRef="a_rem" targetRef="g_m2" />
    <bpmn:sequenceFlow id="p23" sourceRef="a_liv" targetRef="g_m2" />
    <bpmn:sequenceFlow id="p24" sourceRef="g_m2" targetRef="s_clot" />
    <bpmn:sequenceFlow id="p25" sourceRef="s_clot" targetRef="end_ok" />
  </bpmn:process>
