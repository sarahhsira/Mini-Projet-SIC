<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Demande de carte EDAHABIA en ligne (To-Be)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Client">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Système">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Agent de vérification">
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Responsable">
        <bpmn:flowNodeRef>r6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Besoin d'une carte"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="c1" name="Remplir la demande en ligne et joindre les documents"><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s2" name="Contrôler automatiquement champs et pièces jointes"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Dossier complet ?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="s3b" name="Envoyer un email « dossier incomplet »"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="a4" name="Vérifier les documents (Valider / Refuser)"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Documents valides ?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="r6" name="Approuver la demande (Approuver / Refuser)"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Demande approuvée ?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="s5b" name="Envoyer un email de refus avec motif"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="end_rej" name="Demande rejetée"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="s8" name="Lancer la fabrication (statut : en fabrication)"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="a9" name="Confirmer que la carte est fabriquée"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="s10" name="Envoyer SMS / email « Carte prête »"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="c11" name="Retirer la carte avec pièce d'identité"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a12" name="Confirmer la remise de la carte"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end_ok" name="Carte remise"><bpmn:incoming>f18</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="c1" />
    <bpmn:sequenceFlow id="f2" sourceRef="c1" targetRef="s2" />
    <bpmn:sequenceFlow id="f3" sourceRef="s2" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="Non" sourceRef="g1" targetRef="s3b" />
    <bpmn:sequenceFlow id="f5" sourceRef="s3b" targetRef="c1" />
    <bpmn:sequenceFlow id="f6" name="Oui" sourceRef="g1" targetRef="a4" />
    <bpmn:sequenceFlow id="f7" sourceRef="a4" targetRef="g2" />
    <bpmn:sequenceFlow id="f8" name="Oui" sourceRef="g2" targetRef="r6" />
    <bpmn:sequenceFlow id="f9" name="Non" sourceRef="g2" targetRef="s5b" />
    <bpmn:sequenceFlow id="f10" sourceRef="r6" targetRef="g3" />
    <bpmn:sequenceFlow id="f11" name="Non" sourceRef="g3" targetRef="s5b" />
    <bpmn:sequenceFlow id="f12" sourceRef="s5b" targetRef="end_rej" />
    <bpmn:sequenceFlow id="f13" name="Oui" sourceRef="g3" targetRef="s8" />
    <bpmn:sequenceFlow id="f14" sourceRef="s8" targetRef="a9" />
    <bpmn:sequenceFlow id="f15" sourceRef="a9" targetRef="s10" />
    <bpmn:sequenceFlow id="f16" sourceRef="s10" targetRef="c11" />
    <bpmn:sequenceFlow id="f17" sourceRef="c11" targetRef="a12" />
    <bpmn:sequenceFlow id="f18" sourceRef="a12" targetRef="end_ok" />
  </bpmn:process>
