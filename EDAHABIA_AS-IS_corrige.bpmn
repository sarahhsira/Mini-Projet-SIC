    <bpmn:startEvent id="a_start" name="Souhait d'obtenir une carte EDAHABIA"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="a_acces" name="Accéder à E-CCP ou à Mobile ECCP"><bpmn:incoming>s1</bpmn:incoming><bpmn:outgoing>s2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_elig" name="Conditions d'éligibilité remplies ?"><bpmn:incoming>s2</bpmn:incoming><bpmn:outgoing>s3</bpmn:outgoing><bpmn:outgoing>s4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="a_end_elig" name="Demande impossible"><bpmn:incoming>s3</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_cred" name="Identifiants E-CCP disponibles ?"><bpmn:incoming>s4</bpmn:incoming><bpmn:outgoing>s5</bpmn:outgoing><bpmn:outgoing>s9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="a_form" name="Télécharger, imprimer et remplir le formulaire de code E-CCP"><bpmn:incoming>s5</bpmn:incoming><bpmn:outgoing>s6</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="a_depot" name="Déposer le formulaire et la copie de la pièce d'identité au bureau"><bpmn:incoming>s6</bpmn:incoming><bpmn:outgoing>s7</bpmn:outgoing></bpmn:manualTask>
    <bpmn:receiveTask id="a_rcode" name="Recevoir le code d'accès E-CCP"><bpmn:incoming>s7</bpmn:incoming><bpmn:outgoing>s8</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="g_m1"><bpmn:incoming>s8</bpmn:incoming><bpmn:incoming>s9</bpmn:incoming><bpmn:outgoing>s10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="a_login" name="Saisir les identifiants de connexion E-CCP"><bpmn:incoming>s10</bpmn:incoming><bpmn:outgoing>s11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a_choix" name="Choisir l'onglet EDAHABIA : ordinaire ou premium"><bpmn:incoming>s11</bpmn:incoming><bpmn:outgoing>s12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a_conf" name="Renseigner les informations et confirmer la demande"><bpmn:incoming>s12</bpmn:incoming><bpmn:outgoing>s13</bpmn:outgoing></bpmn:userTask>
    <bpmn:eventBasedGateway id="g_evt"><bpmn:incoming>s13</bpmn:incoming><bpmn:outgoing>s14</bpmn:outgoing><bpmn:outgoing>s15</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="a_c_refus" name="Notification de refus reçue"><bpmn:incoming>s15</bpmn:incoming><bpmn:outgoing>s16</bpmn:outgoing><bpmn:messageEventDefinition id="a_c_refus_md" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="a_end_refus" name="Demande refusée"><bpmn:incoming>s16</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="a_c_sms" name="SMS de disponibilité reçu"><bpmn:incoming>s14</bpmn:incoming><bpmn:outgoing>s17</bpmn:outgoing><bpmn:messageEventDefinition id="a_c_sms_md" /></bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="a_depl" name="Se déplacer au bureau de poste de rattachement"><bpmn:incoming>s17</bpmn:incoming><bpmn:outgoing>s18</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="a_pres" name="Présenter la pièce d'identité au guichet"><bpmn:incoming>s18</bpmn:incoming><bpmn:outgoing>s19</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="a_ret" name="Remplir le formulaire de retrait"><bpmn:incoming>s19</bpmn:incoming><bpmn:outgoing>s20</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="a_rec" name="Récupérer la carte et signer l'accusé de réception"><bpmn:incoming>s20</bpmn:incoming><bpmn:outgoing>s21</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="a_end_ok" name="Carte EDAHABIA remise et prête à l'emploi"><bpmn:incoming>s21</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="a_start" targetRef="a_acces" />
    <bpmn:sequenceFlow id="s2" sourceRef="a_acces" targetRef="g_elig" />
