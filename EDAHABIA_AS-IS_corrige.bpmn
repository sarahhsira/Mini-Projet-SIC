        <bpmn:flowNodeRef>b_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="b_ms2" name="Dossier de demande de code E-CCP reçu"><bpmn:outgoing>t1</bpmn:outgoing><bpmn:messageEventDefinition id="b_ms2_md" /></bpmn:startEvent>
    <bpmn:manualTask id="b_dos" name="Recevoir et vérifier le dossier papier"><bpmn:incoming>t1</bpmn:incoming><bpmn:outgoing>t2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="b_g_dos" name="Dossier conforme ?"><bpmn:incoming>t2</bpmn:incoming><bpmn:outgoing>t3</bpmn:outgoing><bpmn:outgoing>t4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="b_code" name="Attribuer et remettre le code confidentiel E-CCP"><bpmn:incoming>t3</bpmn:incoming><bpmn:outgoing>t5</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="b_end_dos" name="Dossier rejeté"><bpmn:incoming>t4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="b_end_code" name="Code E-CCP communiqué"><bpmn:incoming>t5</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="b_ms" name="Demande de connexion reçue"><bpmn:outgoing>u1</bpmn:outgoing><bpmn:messageEventDefinition id="b_ms_md" /></bpmn:startEvent>
    <bpmn:serviceTask id="b_auth" name="Authentifier le client CCP"><bpmn:incoming>u1</bpmn:incoming><bpmn:outgoing>u2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="b_c_conf" name="Demande confirmée reçue"><bpmn:incoming>u2</bpmn:incoming><bpmn:outgoing>u3</bpmn:outgoing><bpmn:messageEventDefinition id="b_c_conf_md" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="b_enreg" name="Enregistrer la commande EDAHABIA"><bpmn:incoming>u3</bpmn:incoming><bpmn:outgoing>u4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="b_verif" name="Prendre en charge et vérifier les informations"><bpmn:incoming>u4</bpmn:incoming><bpmn:outgoing>u5</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="b_g_ok" name="Informations valides ?"><bpmn:incoming>u5</bpmn:incoming><bpmn:outgoing>u6</bpmn:outgoing><bpmn:outgoing>u8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="b_notif" name="Notifier le refus au client"><bpmn:incoming>u6</bpmn:incoming><bpmn:outgoing>u7</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="b_end_rej" name="Demande rejetée"><bpmn:incoming>u7</bpmn:incoming></bpmn:endEvent>
    <bpmn:manualTask id="b_fab" name="Personnaliser et fabriquer la carte EDAHABIA"><bpmn:incoming>u8</bpmn:incoming><bpmn:outgoing>u9</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="b_ach" name="Acheminer la carte vers le bureau de poste"><bpmn:incoming>u9</bpmn:incoming><bpmn:outgoing>u10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="b_recep" name="Réceptionner et enregistrer la carte au bureau"><bpmn:incoming>u10</bpmn:incoming><bpmn:outgoing>u11</bpmn:outgoing></bpmn:manualTask>
    <bpmn:sendTask id="b_sms" name="Envoyer le SMS de disponibilité"><bpmn:incoming>u11</bpmn:incoming><bpmn:outgoing>u12</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="b_vid" name="Vérifier l'identité du titulaire CCP"><bpmn:incoming>u12</bpmn:incoming><bpmn:outgoing>u13</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="b_rem" name="Remettre la carte et le code PIN, faire signer"><bpmn:incoming>u13</bpmn:incoming><bpmn:outgoing>u14</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="b_end_ok" name="Carte remise au client"><bpmn:incoming>u14</bpmn:incoming></bpmn:endEvent>
